FROM docker.io/library/python:3.13.14-slim-bookworm@sha256:de572b33eae61a53675a87bbd02b5e365df7b6b2b06c9276124e965cec08c452

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/app

RUN groupadd --gid 65532 app \
    && useradd --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app
COPY --chown=65532:65532 src /app/src
COPY --chown=65532:65532 scripts/lab.py /app/scripts/lab.py
COPY --chown=65532:65532 lab/host /app/lab/host
COPY --chown=65532:65532 lab/controller /app/lab/controller
COPY --chown=65532:65532 lab/scenarios/registry.json /app/lab/scenarios/registry.json

USER 65532:65532
ENTRYPOINT ["python3", "/app/scripts/lab.py"]
CMD ["container-idle"]
