{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/viggomeesters/arr-orchestrator/main/schemas/repo-vision-contract.schema.json",
  "title": "Arr Orchestrator repository design vision contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "artifact_kind",
    "repo",
    "vision",
    "principles",
    "non_goals",
    "public_safety",
    "acceptance_scorecard",
    "review_checklist",
    "maturity_model",
    "residual_risk_wording"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_kind": {
      "const": "repo_design_vision_contract"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "primary_users",
        "product_surface"
      ],
      "properties": {
        "name": {
          "const": "arr-orchestrator"
        },
        "primary_users": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "product_surface": {
          "const": "agent_first_control_plane"
        }
      }
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_line",
        "north_star",
        "target_users",
        "promise",
        "wedge",
        "assumptions",
        "success_criteria"
      ],
      "properties": {
        "one_line": {
          "type": "string",
          "minLength": 20
        },
        "north_star": {
          "type": "string",
          "minLength": 30
        },
        "target_users": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "promise": {
          "type": "string",
          "minLength": 30
        },
        "wedge": {
          "type": "string",
          "minLength": 30
        },
        "assumptions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "rule",
          "good",
          "bad",
          "enforcement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "rule": {
            "type": "string",
            "minLength": 15
          },
          "good": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "bad": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "enforcement": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "public_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forbidden",
        "required_boundaries",
        "remote_action_gates"
      ],
      "properties": {
        "forbidden": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "required_boundaries": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "remote_action_gates": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "acceptance_scorecard": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "pass_condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "question": {
            "type": "string",
            "minLength": 10
          },
          "pass_condition": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "review_checklist": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "maturity_model": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "state",
          "meaning"
        ],
        "properties": {
          "level": {
            "type": "string",
            "minLength": 2
          },
          "state": {
            "type": "string",
            "minLength": 3
          },
          "meaning": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "residual_risk_wording": {
      "type": "string",
      "minLength": 20
    }
  }
}
