{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arr-orchestrator:schema:runtime-service-endpoints:v1",
  "title": "Arr Orchestrator runtime service endpoints",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "services"],
  "properties": {
    "schema": {"const": "arr-orchestrator.runtime-service-endpoints.v1"},
    "services": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,63}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_url", "secret_ref"],
          "properties": {
            "base_url": {
              "type": "string",
              "pattern": "^https?://(?=[A-Za-z0-9.-]{1,253}(?::|/|$))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/?$"
            },
            "secret_ref": {
              "type": "string",
              "pattern": "^file:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
